root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
# Match ruff format (Black style): 4-space hanging indent, not PyCharm's default 8.
ij_continuation_indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.toml]
# uv writes pyproject.toml arrays with 4-space indents.
indent_size = 4
